rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. GLOBAL HELPERS
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. COLLECTION RULES
    
    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['name', 'age', 'weight', 'height', 'goal', 'level']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 100;
    }

    // Plans
    match /plans/{planId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Meals
    match /meals/{mealId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get, write: if isSignedIn() && (
        (request.method == 'create' || request.method == 'update') ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid
      );
    }

    // History
    match /history/{historyId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get, write: if isSignedIn() && (
        (request.method == 'create' || request.method == 'update') ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid
      );
    }
  }
}
